# Margot environment template
# Replace placeholders locally. Do not commit real credentials.

# Frontend: place in frontend/.env (Vite app root)
VITE_API_URL=http://127.0.0.1:8000

# Backend: place in backend/.env if these names match your Python settings
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster-host>/<database>?retryWrites=true&w=majority
MONGODB_DATABASE=margot
GEMINI_API_KEY=your_gemini_api_key_here
JWT_SECRET_KEY=replace_with_a_long_random_secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
